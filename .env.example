# Local development or Coolify application environment
DATABASE_URL=postgres://bcm:***@localhost:5432/bcm

# Server-side identity sessions. Required in production; use at least 32
# random bytes (`openssl rand -base64 32`). The value configured here MUST
# match the BCM_SESSION_SECRET GitHub Actions secret used by the deploy
# smoke test, and MUST NOT equal the committed e2e test value
# ("bcm-playwright-identity-session-secret", tests/e2e/identity-session.ts) —
# lib/identity/session.ts rejects that value in production. Role claims use
# groups such as bcm:role:change_manager.
BCM_SESSION_SECRET=
# Optional server-owned fallback identity (for a trusted deployment adapter).
BCM_IDENTITY_USER_ID=
BCM_IDENTITY_DISPLAY_NAME=
BCM_IDENTITY_GROUPS=
BCM_IDENTITY_TENANT=
BCM_IDENTITY_BUSINESS_UNIT=
# Profile switching is enabled by default: both compose files default
# BCM_ENABLE_IDENTITY_SWITCHER to true and issue a change_manager identity
# (workflow:view + design/test/publish), so Workflow Studio is reachable on
# every deployment path. Set BCM_DISABLE_IDENTITY_SWITCHER=true to force it
# off. A strong BCM_SESSION_SECRET (above) is required in production-mode
# containers (NODE_ENV=production is pinned in the Dockerfile).
# BCM_ENABLE_IDENTITY_SWITCHER=true
# BCM_DISABLE_IDENTITY_SWITCHER=true

# Workflow Studio rollout flags. Both compose files default the Studio flags
# to true (builder controls routes/navigation; publishing stays independent).
# Runtime start remains opted out by design — enable only for the runtime
# rollout. All flags fail closed when absent.
BCM_FEATURE_WORKFLOW_STUDIO_BUILDER=true
BCM_FEATURE_WORKFLOW_STUDIO_PUBLISH=true
BCM_FEATURE_WORKFLOW_RUNTIME_START=false

# GitHub personal access token with "issues: write" scope for the feedback form
GITHUB_TOKEN=

# When set to "true", the feedback server action skips the real GitHub POST
# and returns a deterministic success URL. The Playwright e2e suite always
# enables this (playwright.config.ts webServer env) so test runs never create
# real GitHub issues from the feedback form.
# FEEDBACK_DRY_RUN=true

# Sentry error monitoring (https://sentry.io)
# Create a project at https://sentry.io -> Projects -> Create Project -> Next.js
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Stakeholder notifications — webhook URLs
# Overridden by values in the notification_config DB table if set
WEBHOOK_ADMINISTRATIE=
WEBHOOK_ASSET_SERVICE=
WEBHOOK_FACTSET=

# Stakeholder notifications — email recipients (used as fallback)
NOTIFY_EMAIL_ADMINISTRATIE=
NOTIFY_EMAIL_ASSET_SERVICE=
NOTIFY_EMAIL_FACTSET=

# SMTP configuration for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bcm.7rb.nl
